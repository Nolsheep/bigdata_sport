# Copy to .env and fill in. Never commit .env or credentials.json.

# PostgreSQL (must match docker-compose.yml)
POSTGRES_USER=nba
POSTGRES_PASSWORD=nba_password
POSTGRES_DB=nba
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Kaggle dataset (https://www.kaggle.com/datasets/nathanlauga/nba-games)
KAGGLE_DATASET=nathanlauga/nba-games
DATA_DIR=data
# Either put kaggle.json in ~/.kaggle/ or set these two:
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=your_api_key

# Google Sheets publishing
GOOGLE_CREDENTIALS_FILE=credentials.json
# The long id in the sheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
