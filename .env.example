# --- PostgreSQL (docker-compose.yml reads these too) ---
POSTGRES_USER=nba
POSTGRES_PASSWORD=nba_password
POSTGRES_DB=nba_dw
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Kaggle ---
KAGGLE_DATASET=nathanlauga/nba-games
# Optional: use CSVs already on disk instead of downloading
# LOCAL_DATA_DIR=./data

# --- Google Sheets ---
GOOGLE_CREDENTIALS_FILE=credentials.json
# Spreadsheet ID from the URL: https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=
